<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:id="@+id/place_account_finance_journal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txt_label_income_expense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ubuntu_b"
                android:padding="10dp"
                android:text="Total pengeluaran dan pemasukan"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="15sp" />

            <ImageView
                android:id="@+id/img_choose_filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="10dp"
                android:src="@drawable/ic_baseline_more_vert_24"
                app:tint="?attr/colorOnSurface" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rl_choose_year"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:background="@drawable/shape_line_gray"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btn_prev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:background="@android:color/transparent"
                android:padding="10dp"
                android:src="@drawable/ic_baseline_keyboard_arrow_left_24"
                app:tint="@color/blackTextColor" />

            <RelativeLayout
                android:id="@+id/place_month"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginBottom="16dp"
                android:layout_toStartOf="@id/btn_next"
                android:layout_toEndOf="@id/btn_prev">

                <TextView
                    android:id="@+id/txt_year"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_r"
                    android:padding="10dp"
                    android:text="2022"
                    android:textAlignment="center"
                    android:textColor="@color/blackTextColor"
                    android:textSize="15sp" />


            </RelativeLayout>

            <ImageButton
                android:id="@+id/btn_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="10dp"
                android:background="@android:color/transparent"
                android:padding="10dp"
                android:src="@drawable/ic_baseline_keyboard_arrow_right_24"
                app:tint="@color/blackTextColor" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="5dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:id="@+id/ll_expense"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:id="@+id/card_expense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#A82C23"
                    app:cardCornerRadius="16dp"
                    android:layout_marginBottom="10dp"
                    app:cardElevation="10dp">

                    <RelativeLayout
                        android:id="@+id/place_target"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="5dp"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/icon_expense"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawablePadding="5dp"
                            android:padding="10dp"
                            android:src="@drawable/baseline_payments_24"
                            app:tint="@color/red" />


                        <TextView
                            android:id="@+id/txt_total_expense"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/icon_expense"
                            android:drawablePadding="5dp"
                            android:fontFamily="@font/calibri"
                            android:padding="16dp"
                            android:text="Rp.0"
                            android:textAlignment="center"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </RelativeLayout>
                </androidx.cardview.widget.CardView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_expense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:id="@+id/ll_income"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:id="@+id/card_income"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="#2A752C"
                    app:cardCornerRadius="16dp"
                    android:layout_marginBottom="10dp"
                    app:cardElevation="10dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/icon_income"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:drawablePadding="5dp"
                            android:padding="10dp"
                            android:src="@drawable/ic_baseline_account_balance_wallet_24"
                            app:tint="@color/green" />

                        <TextView
                            android:id="@+id/txt_total_income"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/icon_income"
                            android:drawablePadding="5dp"
                            android:fontFamily="@font/calibri"
                            android:padding="16dp"
                            android:text="Rp.50.000"
                            android:textAlignment="center"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </RelativeLayout>

                </androidx.cardview.widget.CardView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_income"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</layout>
