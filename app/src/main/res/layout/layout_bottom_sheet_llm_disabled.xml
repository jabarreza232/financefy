<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="24dp"
    android:paddingTop="12dp"
    android:paddingBottom="32dp">

    <!-- Drag Handle (Garis kecil di atas) -->
    <androidx.cardview.widget.CardView
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="#E0E0E0"
        app:cardCornerRadius="2dp"
        app:cardElevation="0dp" />

    <!-- Ilustrasi -->
    <!-- Ganti src dengan ilustrasi yang Anda punya, atau biarkan menggunakan ikon memori/scanner -->
    <ImageView
        android:id="@+id/bs_img_illustration"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginBottom="16dp"
        android:padding="20dp"
        android:src="@drawable/ic_baseline_memory_24"
        app:tint="@color/colorPrimary" />

    <!-- Judul -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/ubuntu_b"
        android:text="Fitur Scan AI Nonaktif"
        android:textAlignment="center"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Deskripsi -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:lineSpacingExtra="4dp"
        android:text="Pemindaian struk otomatis membutuhkan kecerdasan AI lokal untuk menyusun data ke dalam form.\n\nSilakan aktifkan Mode AI di menu Pengaturan."
        android:textAlignment="center"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="14sp" />

    <!-- Tombol Aksi -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bs_btn_batal_llm"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:text="Batal"
            android:textColor="@color/colorGrey"
            app:cornerRadius="12dp"
            app:strokeColor="@color/colorGrey" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bs_btn_setting_llm"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Pengaturan"
            android:textColor="@android:color/white"
            app:backgroundTint="@color/colorPrimary"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>