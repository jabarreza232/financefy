<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="5dp"
        android:id="@+id/cv_savings_target"
        android:orientation="horizontal"
        app:cardElevation="5dp">


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_margin="5dp"
            android:orientation="vertical">


            <RelativeLayout
                android:layout_toStartOf="@+id/img_arrow_right"
                android:id="@+id/rl_savings_target"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                >

                <TextView
                    android:id="@+id/txt_judul"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_toStartOf="@id/txt_percentage"
                    android:fontFamily="@font/ubuntu_b"
                    android:textColor="@android:color/black"
                    android:textSize="13sp"
                    tools:text="Dapat Uang jajan" />

                <TextView
                    android:id="@+id/txt_percentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="5dp"
                    android:layout_marginEnd="5dp"
                    android:fontFamily="@font/ubuntu_r"
                    android:gravity="center"
                    android:text="20%"
                    android:textColor="@android:color/black"
                    android:textSize="13sp"
                    tools:text="20%" />

                <ProgressBar
                    android:id="@+id/progress_savings"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/txt_judul"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_toStartOf="@+id/img_arrow_right"
                    android:progressDrawable="@drawable/progress_income_drawable"
                    tools:ignore="UnusedAttribute" />

                <TextView
                    android:id="@+id/txt_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/progress_savings"
                    android:layout_marginTop="7dp"
                    android:layout_marginEnd="10dp"
                    android:fontFamily="@font/ubuntu_r"
                    android:textColor="@android:color/black"
                    android:textSize="13sp"
                    tools:text="Rp.20.000 s/d Rp.50.000" />

                <TextView
                    android:id="@+id/txt_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/progress_savings"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="7dp"
                    android:layout_marginEnd="10dp"
                    android:fontFamily="@font/ubuntu_r"
                    android:textColor="@android:color/black"
                    android:textSize="13sp"
                    tools:text="Sisa 28 hari" />


            </RelativeLayout>

            <LinearLayout
                android:layout_toStartOf="@+id/img_arrow_right"
                android:layout_below="@id/rl_savings_target"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/img_edit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="5dp"
                    android:layout_toStartOf="@id/img_remove"
                    android:padding="5dp"
                    android:src="@drawable/ic_edit"
                    app:tint="@color/blueColor" />

                <ImageView
                    android:id="@+id/img_remove"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:padding="5dp"
                    android:src="@drawable/ic_baseline_delete_outline_24"
                    android:tint="@color/red" />

            </LinearLayout>

            <ImageView
                android:id="@+id/img_arrow_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_baseline_keyboard_arrow_right_24"
                app:tint="@color/blackTextColor" />
        </RelativeLayout>

    </androidx.cardview.widget.CardView>
</layout>
