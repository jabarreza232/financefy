<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp">

                <RelativeLayout
                    android:id="@+id/rl_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@id/txt_percentage">

                    <TextView
                        android:id="@+id/txt_kategori"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:layout_toStartOf="@id/txt_jumlah"
                        android:fontFamily="@font/ubuntu_b"
                        android:textColor="?android:textColorPrimary"
                        android:textSize="15sp"
                        tools:text="Makanan" />


                    <TextView
                        android:id="@+id/txt_jumlah"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="7dp"
                        android:fontFamily="@font/ubuntu_r"
                        android:textColor="?android:textColorPrimary"
                        android:textSize="13sp"
                        tools:text="Rp.15000" />

                    <TextView
                        android:id="@+id/txt_jumlah_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/txt_kategori"
                        android:layout_marginTop="7dp"
                        android:fontFamily="@font/ubuntu_r"
                        android:textColor="?android:textColorPrimary"
                        android:textSize="13sp"
                        android:visibility="gone"
                        tools:text="Rp.15000" />
                    <TextView
                        android:layout_marginTop="7dp"
                        android:id="@+id/txt_percentage_2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ubuntu_r"
                        android:layout_below="@id/txt_jumlah_2"
                        android:text="17%"
                        android:padding="3dp"
                        android:visibility="gone"
                        android:textColor="?android:textColorPrimary"
                        android:textSize="13sp" />

                </RelativeLayout>

                <ProgressBar
                    android:id="@+id/progress_finance"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/rl_text"
                    android:layout_marginTop="10dp"
                    android:layout_toStartOf="@id/txt_percentage"
                    android:progressDrawable="@drawable/progress_income_drawable"
                    tools:ignore="UnusedAttribute" />

                <TextView
                    android:id="@+id/txt_percentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:fontFamily="@font/ubuntu_r"
                    android:padding="10dp"
                    android:text="17%"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="13sp" />

            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="@color/colorGrey30" />
        </LinearLayout>

    </LinearLayout>
</layout>