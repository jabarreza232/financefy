<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/white"
            android:orientation="vertical"
            tools:context=".fragment.FragmentAll">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/TextInputLayoutOutlineTheme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:hint="@string/choose_account">

                <AutoCompleteTextView
                    android:id="@+id/spin_choose_account"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:ellipsize="end"
                    android:inputType="none"
                    tools:text="M Jabbar" />
            </com.google.android.material.textfield.TextInputLayout>


            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="10dp"
                android:background="@drawable/shape_line_gray">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/txt_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@id/img_edit"
                        android:fontFamily="@font/ubuntu_b"
                        android:text="@string/sample_name"
                        android:textColor="@color/blackTextColor"
                        android:textSize="15sp" />

                    <ImageView
                        android:id="@+id/img_more"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:src="@drawable/ic_baseline_more_vert_24" />


                    <TextView
                        android:id="@+id/txt_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/txt_name"
                        android:layout_toStartOf="@id/img_more"
                        android:fontFamily="@font/ubuntu_r"
                        android:text="Pribadi - Menabung"
                        android:textColor="@color/blackTextColor"
                        android:textSize="13sp" />

                </RelativeLayout>


            </FrameLayout>


            <include
                android:id="@+id/layout_account_savings"
                layout="@layout/layout_account_savings" />
            <include
                android:id="@+id/layout_account_finance_journal"
                layout="@layout/layout_account_finance_journal" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fab_add_account"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_margin="16dp"
            android:gravity="center"
            android:padding="10dp"
            android:text="Tambah Akun"
            android:textColor="@color/white"
            app:backgroundTint="@color/blueColor"
            app:icon="@drawable/ic_add"
            app:iconGravity="end"
            app:iconTint="@color/white" />
    </RelativeLayout>
</layout>
