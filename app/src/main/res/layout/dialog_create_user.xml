<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <RelativeLayout
        android:id="@+id/place_form"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_form">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingBottom="24dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <!-- HEADER -->
                <TextView
                    android:id="@+id/txt_header"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/lato_bold"
                    android:text="Masukkan form pengguna"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="20sp"
                    app:layout_constraintBottom_toBottomOf="@+id/img_close"
                    app:layout_constraintEnd_toStartOf="@+id/img_close"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/img_close" />

                <ImageView
                    android:id="@+id/img_close"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?selectableItemBackgroundBorderless"
                    android:padding="8dp"
                    android:src="@drawable/ic_close"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:tint="?attr/colorOnSurface" />

                <View
                    android:id="@+id/divider_1"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/colorGrey30"
                    app:layout_constraintTop_toBottomOf="@+id/img_close" />

                <!-- FORM PENGGUNA -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_name"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Nama"
                    app:errorEnabled="true"
                    app:layout_constraintTop_toBottomOf="@+id/divider_1">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- DROPDOWN TIPE (Full Width) -->
                <RelativeLayout
                    android:id="@+id/place_type"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/shape_date"
                    app:layout_constraintTop_toBottomOf="@+id/til_name">

                    <TextView
                        android:id="@+id/txt_type"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:text="Tipe"
                        android:textColor="?android:attr/textColorPrimary" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_alignParentEnd="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:paddingHorizontal="16dp"
                        android:src="@drawable/ic_arrow_drop_down"
                        app:tint="?attr/colorOnSurface" />
                </RelativeLayout>

                <!-- GUIDELINE UNTUK MEMBAGI LAYAR 50:50 -->
                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guideline_center"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent="0.5" />

                <!-- DROPDOWN KATEGORI (Kiri) -->
                <RelativeLayout
                    android:id="@+id/place_category"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/shape_date"
                    app:layout_constraintEnd_toStartOf="@+id/guideline_center"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/place_type">

                    <TextView
                        android:id="@+id/txt_category"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:text="Kategori"
                        android:textColor="?android:attr/textColorPrimary" />

                    <ImageView
                        android:id="@+id/img_dropdown_category"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_alignParentEnd="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:paddingHorizontal="12dp"
                        android:src="@drawable/ic_arrow_drop_down"
                        app:tint="?attr/colorOnSurface" />
                </RelativeLayout>

                <!-- DROPDOWN TIPE MATA UANG (Kanan) -->
                <RelativeLayout
                    android:id="@+id/place_type_currency"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="16dp"
                    android:enabled="false"

                    android:background="@drawable/shape_date"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/guideline_center"
                    app:layout_constraintTop_toBottomOf="@+id/place_type">

                    <TextView
                    android:enabled="false"
                        android:id="@+id/txt_type_currency"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:text="Mata Uang"
                        android:textColor="?android:attr/textColorPrimary" />

                    <ImageView
                        android:enabled="false"

                        android:id="@+id/img_dropdown_type_currency"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_alignParentEnd="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:paddingHorizontal="12dp"
                        android:src="@drawable/ic_arrow_drop_down"
                        app:tint="?attr/colorOnSurface" />
                </RelativeLayout>

                <!-- HEADER TARGET MENABUNG (Toggable) -->
                <TextView
                    android:id="@+id/txt_header_target_savings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/lato_bold"
                    android:text="Masukkan form target menabung"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="20sp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@+id/place_category" />

                <View
                    android:id="@+id/view_line_target_savings"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/colorGrey30"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@+id/txt_header_target_savings" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_title"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:hint="Judul Target"
                    android:visibility="gone"
                    app:errorEnabled="true"
                    app:layout_constraintTop_toBottomOf="@+id/view_line_target_savings">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- TANGGAL (Kiri) -->
                <RelativeLayout
                    android:id="@+id/place_date"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/shape_date"
                    android:visibility="gone"
                    app:layout_constraintEnd_toStartOf="@+id/guideline_center"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/til_title">

                    <TextView
                        android:id="@+id/txt_date"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="?attr/selectableItemBackground"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:text="Tanggal"
                        android:textColor="?android:attr/textColorPrimary" />

                    <ImageView
                        android:id="@+id/img_date"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_alignParentEnd="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:paddingHorizontal="12dp"
                        android:src="@drawable/ic_date_range"
                        app:tint="?attr/colorOnSurface" />
                </RelativeLayout>

                <!-- MATA UANG TARGET (Kanan, Disabled) -->
                <RelativeLayout
                    android:id="@+id/place_type_currency_target_savings"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/shape_date"
                    android:clickable="false"
                    android:visibility="gone"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/guideline_center"
                    app:layout_constraintTop_toBottomOf="@+id/til_title">

                    <TextView
                        android:id="@+id/txt_type_currency_target"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:enabled="false"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:text="Mata Uang"
                        android:textColor="@color/colorGrey50" />

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_alignParentEnd="true"
                        android:paddingHorizontal="12dp"
                        android:src="@drawable/ic_arrow_drop_down"
                        app:tint="@color/colorGrey50" />
                </RelativeLayout>

                <!-- TARGET VALUE & CALCULATOR WADAH (Toggable) -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/place_target_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@+id/place_date">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_target_value"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:hint="Jumlah Uang"
                        app:errorEnabled="true"
                        app:layout_constraintEnd_toStartOf="@+id/btn_calculator"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_target_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="numberDecimal" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/btn_calculator"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginBottom="16dp"
                        android:layout_marginEnd="2dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="2dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:cardBackgroundColor="@color/bg_action_light"> <!-- Menggunakan warna dari resource -->
                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="16dp"
                            android:background="?attr/selectableItemBackground"
                            android:src="@drawable/ic_outline_calculate_24"
                            app:tint="@color/colorPrimary" />
                    </androidx.cardview.widget.CardView>
                </androidx.constraintlayout.widget.ConstraintLayout>

                <!-- TOMBOL SUBMIT (Diubah menjadi MaterialButton) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cv_submit"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/ubuntu_b"
                    android:textAlignment="center"
                    android:paddingTop="10dp"
                    android:textColor="@color/white"
                    android:text="Simpan"
                    android:textSize="16sp"
                    app:backgroundTint="?attr/colorPrimary"
                    app:cornerRadius="25dp"
                    app:layout_constraintTop_toBottomOf="@+id/place_target_value" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>
    </RelativeLayout>
</layout>