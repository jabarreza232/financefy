<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        >

        <androidx.core.widget.NestedScrollView
            android:id="@+id/ns_view"
            android:layout_width="match_parent"
            android:background="?attr/colorSurface"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/colorSurface"
                android:orientation="vertical"
                tools:context=".fragment.FragmentAll">

                <LinearLayout
                    android:id="@+id/ll_app_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@color/colorPrimary"
                    android:orientation="vertical">
                    <FrameLayout
                        android:id="@+id/fl_header_wrapper"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                    <LinearLayout
                        android:id="@+id/ll_header_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <androidx.cardview.widget.CardView
                            android:id="@+id/header_view"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginHorizontal="16dp"
                            android:layout_marginTop="16dp"
                            android:layout_marginBottom="8dp"
                            app:cardBackgroundColor="?attr/colorSurface"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="2dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:paddingBottom="16dp">

                                <!-- Navigasi Bulan -->
                                <RelativeLayout
                                    android:id="@+id/place_date_month"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content">

                                    <ImageButton
                                        android:id="@+id/btn_prev"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="10dp"
                                        android:layout_marginTop="6dp"
                                        android:background="?attr/selectableItemBackgroundBorderless"
                                        android:padding="9dp"
                                        android:src="@drawable/ic_baseline_keyboard_arrow_left_24"
                                        app:tint="?attr/colorOnSurface" />

                                    <RelativeLayout
                                        android:id="@+id/place_month"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginHorizontal="10dp"
                                        android:layout_marginBottom="10dp"
                                        android:layout_toStartOf="@id/btn_next"
                                        android:layout_toEndOf="@id/btn_prev">

                                        <TextView
                                            android:id="@+id/txt_month"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:background="?attr/selectableItemBackground"
                                            android:fontFamily="@font/ubuntu_r"
                                            android:padding="16dp"
                                            android:text="Month"
                                            android:textAlignment="center"
                                            android:textColor="?android:attr/textColorPrimary"
                                            android:textSize="17sp" />
                                    </RelativeLayout>

                                    <ImageButton
                                        android:id="@+id/btn_next"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentEnd="true"
                                        android:layout_marginTop="6dp"
                                        android:layout_marginEnd="10dp"
                                        android:background="?attr/selectableItemBackgroundBorderless"
                                        android:padding="9dp"
                                        android:src="@drawable/ic_baseline_keyboard_arrow_right_24"
                                        app:tint="?attr/colorOnSurface" />
                                </RelativeLayout>

                                <!-- Sapaan Pengguna -->
                                <TextView
                                    android:id="@+id/txt_name"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_below="@id/place_date_month"
                                    android:layout_marginHorizontal="16dp"
                                    android:layout_marginTop="8dp"
                                    android:fontFamily="@font/ubuntu_b"
                                    android:text="Good morning, Muhammad Jabbar Syahrial Reza!"
                                    android:textColor="?android:attr/textColorPrimary"
                                    android:textSize="20sp" />

                                <!-- Tipe Akun -->
                                <TextView
                                    android:id="@+id/txt_type_account"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_below="@id/txt_name"
                                    android:layout_marginHorizontal="16dp"
                                    android:layout_marginTop="4dp"
                                    android:fontFamily="@font/ubuntu_r"
                                    android:text="Bisnis"
                                    android:textColor="?attr/colorPrimary"
                                    android:textSize="14sp" />

                            </RelativeLayout>
                        </androidx.cardview.widget.CardView>

                        <!-- KARTU 2: DASHBOARD KEUANGAN (Termasuk Saldo & Split Income/Expense) -->
                        <include
                            android:id="@+id/layout_finance_journal"
                            layout="@layout/layout_finance_journal" />

                    </LinearLayout>
                    </FrameLayout>
                    <com.google.android.material.floatingactionbutton.FloatingActionButton
                        android:id="@+id/btn_toggle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_margin="10dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_arrow_up"
                        app:backgroundTint="@color/white"
                        app:borderWidth="6dp"
                        app:elevation="16dp"
                        app:fabSize="mini"
                        app:pressedTranslationZ="0dp"
                        app:tint="@color/colorAccent" />
                </LinearLayout>
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_ledger"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="16dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@color/colorGrey30"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:fontFamily="@font/ubuntu_b"
                            android:text="Laporan Pembukuan"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="16sp" />

                        <!-- WADAH BARIS PEMBUKUAN (Diisi dinamis dari Java) -->
                        <LinearLayout
                            android:id="@+id/ll_ledger_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <!-- Garis pemisah -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginVertical="12dp"
                            android:background="@color/colorGrey30" />

                        <!-- Total Saldo Bersih -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:fontFamily="@font/ubuntu_b"
                                android:text="Saldo Bersih"
                                android:textColor="?android:attr/textColorPrimary"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/txt_net_balance"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:fontFamily="@font/ubuntu_b"
                                android:text="Rp 0"
                                android:textColor="?attr/colorPrimary"
                                android:textSize="16sp" />
                        </RelativeLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- TOMBOL GENERATE AI -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_generate_ai"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/ubuntu_b"
                    android:text="Generate Analisis AI"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:paddingTop="10dp"
                    app:cornerRadius="12dp"
                    app:iconGravity="textStart" />

                <!-- KARTU AI SMART INSIGHT (Muncul saat tombol diklik) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_ai_insight"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="#F0F8FF"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/bg_action_light"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/baseline_monetization_on_24"
                            app:tint="?attr/colorPrimary" />

                        <TextView
                            android:id="@+id/txt_ai_insight"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFamily="@font/ubuntu_r"
                            android:lineSpacingExtra="4dp"
                            android:text="Memuat analisis..."
                            android:textColor="@color/colorPrimary"
                            android:textSize="14sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pie_chart_analysis"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
android:layout_marginTop="16dp"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone"
                 />

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/bar_chart_analysis"
                    android:layout_width="match_parent"
                    android:layout_height="250dp"
                    android:layout_marginBottom="10dp" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <LinearLayout
                    android:id="@+id/place_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/empty"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:src="@drawable/empty" />

                    <TextView
                        android:id="@+id/txt_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/ubuntu_b"
                        android:text="Tidak ada data"
                        android:textAlignment="center"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textSize="19sp" />
                </LinearLayout>
            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </RelativeLayout>

</layout>
