<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">


        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="10dp"
            android:layout_margin="6dp"

            >


            <RelativeLayout
                android:layout_width="match_parent"
                android:padding="6dp"
                android:layout_height="wrap_content"
                >

                <RelativeLayout
                    android:id="@+id/rl_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/txt_kategori"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:fontFamily="@font/ubuntu_b"
                        android:textColor="?android:textColorPrimary"
                        android:textSize="15sp"
                        tools:text="Makanan" />

                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/txt_kategori"
                        android:layout_marginTop="10dp"
                        app:cardBackgroundColor="@color/blueColor"
                        app:cardElevation="6dp"
                        app:cardCornerRadius="10dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="10dp">

                            <TextView
                                android:id="@+id/txt_jumlah_2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                android:fontFamily="@font/ubuntu_r"
                                android:textColor="@color/white"
                                android:textSize="13sp"
                                tools:text="Rp.15000" />

                            <TextView
                                android:id="@+id/txt_percentage_2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/txt_jumlah_2"
                                android:layout_marginTop="7dp"
                                android:fontFamily="@font/ubuntu_r"
                                android:padding="3dp"
                                android:text="17%"
                                android:textColor="@color/white"
                                android:textSize="13sp" />

                            <ProgressBar
                                android:id="@+id/progress_finance"
                                style="@android:style/Widget.ProgressBar.Horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/txt_percentage_2"
                                android:layout_marginTop="10dp"
                                android:layout_marginEnd="5dp"
                                android:progressDrawable="@drawable/progress_income_drawable"
                                tools:ignore="UnusedAttribute" />


                        </RelativeLayout>
                    </androidx.cardview.widget.CardView>


                </RelativeLayout>


            </RelativeLayout>

           </androidx.cardview.widget.CardView>

    </LinearLayout>
</layout>