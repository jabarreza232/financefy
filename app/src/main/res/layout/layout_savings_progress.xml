<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/linearlayout_savings_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/txt_type_account"
        android:orientation="horizontal">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp">


                <TextView
                    android:id="@+id/txt_title"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="5dp"
                    android:layout_toStartOf="@id/txt_percentage"
                    android:drawableEnd="@drawable/ic_arrow_drop_down"
                    android:ellipsize="end"
                    android:fontFamily="@font/lato_bold"
                    android:gravity="start|center"
                    android:lines="1"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp"
                    tools:text="Pencapaian"
                    app:drawableTint="?attr/colorOnSurface" />


                <TextView
                    android:id="@+id/txt_percentage"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="7dp"
                    android:layout_marginEnd="10dp"
                    android:fontFamily="@font/ubuntu_r"
                    android:gravity="center"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp"
                    tools:text="20%" />


                <ProgressBar
                    android:id="@+id/progress_savings"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/txt_title"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="10dp"
                    android:progressDrawable="@drawable/progress_income_drawable"
                    tools:ignore="UnusedAttribute" />

                <TextView
                    android:id="@+id/txt_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/progress_savings"
                    android:layout_marginTop="7dp"
                    android:layout_marginEnd="10dp"
                    android:fontFamily="@font/ubuntu_r"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp"
                    tools:text="Rp.20.000 s/d Rp.50.000" />

                <TextView
                    android:id="@+id/txt_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/progress_savings"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="7dp"
                    android:layout_marginEnd="10dp"
                    android:fontFamily="@font/ubuntu_r"
                    android:textColor="?android:attr/textColorPrimary"
                    android:textSize="15sp"
                    tools:text="Sisa 28 hari" />
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:background="@color/colorGrey30" />
            <RelativeLayout
                android:id="@+id/rl_savings_recommendation_target"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:background="@color/blueColor">

                <TextView
                    android:id="@+id/txt_recommendation_saving"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@id/img_choose_recommendation"
                    android:fontFamily="@font/ubuntu_b"
                    android:padding="10dp"
                    android:text="Rekomendasi menabung perhari: Rp.500.000"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <ImageView
                    android:id="@+id/img_choose_recommendation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:padding="10dp"
                    android:src="@drawable/ic_baseline_more_vert_24"
                    app:tint="@color/white" />

            </RelativeLayout>

        </LinearLayout>

    </LinearLayout>
</layout>
