<?xml version="1.0" encoding="utf-8"?>
<layout >

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:id="@+id/place_account_savings"
    android:visibility="gone"
   >


    <androidx.cardview.widget.CardView
        android:id="@+id/place_choose_savings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        app:cardElevation="10dp"
        android:background="@drawable/shape_line_gray">

        <TextView
            android:background="?attr/selectableItemBackground"
            android:id="@+id/txt_choose_savings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:fontFamily="@font/ubuntu_b"
            android:text="Pilih Tabungan"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
android:padding="3dp"
            android:layout_margin="13dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_drop_down"
            app:tint="?attr/colorOnSurface"
            />


    </androidx.cardview.widget.CardView>
    <TextView
        android:layout_margin="10dp"
        android:background="@drawable/shape_line_blue"
        android:textAlignment="center"
        android:id="@+id/txt_description_saving"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ubuntu_b"
        android:text="Target dan progress menabung \n\nWaktu: 2 bulan 30 hari lagi"
        android:textColor="?android:attr/textColorPrimary"
        android:padding="10dp"
        android:textSize="15sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="5dp"
        android:weightSum="2">
        <androidx.cardview.widget.CardView
            xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            app:cardElevation="10dp"
            android:background="@drawable/shape_line_gray">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Icon and Title Section -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingBottom="16dp">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:src="@drawable/baseline_account_balance_wallet_24"
                        app:tint="@color/blueColorLight" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/lato_bold"
                        android:text="Target Menabung"
                        android:textColor="@color/blueColorLight"
                        android:textSize="18sp" />
                </LinearLayout>

                <!-- Divider Line -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/colorGrey30" />

                <!-- Target Savings Amount -->
                <TextView
                    android:id="@+id/txt_target"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="16dp"
                    android:fontFamily="@font/ubuntu_r"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:text="Rp.50.000"
                    android:textColor="@color/blueColorLight" />

                <!-- Progress and Percentage Layout -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="16dp">

                    <!-- Current Savings Amount -->
                    <TextView
                        android:id="@+id/txt_progress_value_savings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/ubuntu_r"
                        android:text="Rp.15.000"
                        android:textColor="@color/colorPrimaryGreen"
                        android:textSize="15sp" />

                    <!-- Savings Percentage -->
<!--                    <TextView-->
<!--                        android:id="@+id/txt_percentage_savings"-->
<!--                        android:layout_width="wrap_content"-->
<!--                        android:layout_height="wrap_content"-->
<!--                        android:layout_alignParentEnd="true"-->
<!--                        android:fontFamily="@font/lato_bold"-->
<!--                        android:padding="10dp"-->
<!--                        android:text="17%"-->
<!--                        android:textStyle="bold"-->
<!--                        android:textColor="@color/colorPrimaryGreen"-->
<!--                        android:textSize="15sp" />-->

                    <!-- Progress Bar -->
                    <ProgressBar
                        android:id="@+id/progress_bar_target_savings"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/txt_progress_value_savings"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:progressDrawable="@drawable/progress_income_drawable" />
                </RelativeLayout>

                <!-- Description or Additional Info -->
                <TextView
                    android:id="@+id/txt_percentage_savings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ubuntu_r"
                    android:text="Selamat, Anda sudah mencapai 30% dari target menabung Anda!"
                    android:textColor="@color/colorPrimaryGreen"
                    android:textSize="14sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="10dp"
        app:cardElevation="10dp"
        >
    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/rv_progress_savings"
       android:visibility="gone" />
    </androidx.cardview.widget.CardView>
</LinearLayout>

</layout>