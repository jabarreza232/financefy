<?xml version="1.0" encoding="utf-8"?>
<layout >

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
android:visibility="gone"
    android:id="@+id/place_account_savings"
   >


    <androidx.cardview.widget.CardView
        android:id="@+id/place_choose_savings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        app:cardElevation="10dp"
        android:background="@drawable/shape_line_gray">

        <TextView
            android:background="?attr/selectableItemBackground"
            android:id="@+id/txt_choose_savings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:fontFamily="@font/ubuntu_b"
            android:text="Pilih Tabungan"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
android:padding="3dp"
            android:layout_margin="13dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_drop_down"
            app:tint="?attr/colorOnSurface"
            />


    </androidx.cardview.widget.CardView>
    <TextView
        android:layout_margin="10dp"
        android:background="@drawable/shape_line_blue"
        android:textAlignment="center"
        android:id="@+id/txt_description_saving"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/ubuntu_b"
        android:text="Target dan progress menabung \n\nWaktu: 2 bulan 30 hari lagi"
        android:textColor="?android:attr/textColorPrimary"
        android:padding="10dp"
        android:textSize="15sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_margin="5dp"
        android:weightSum="2">
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_margin="5dp"
        app:cardElevation="10dp"
        android:background="@drawable/shape_line_gray"
        >

        <LinearLayout
            android:id="@+id/place_target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="5dp"
            android:orientation="vertical">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="5dp"
                android:src="@drawable/baseline_account_balance_wallet_24"
                android:padding="10dp"
                app:tint="@color/blueColorLight"
                />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/colorGrey30" />

            <TextView
                android:id="@+id/txt_target"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/ic_baseline_gps_fixed_24"
                android:drawablePadding="5dp"
                android:fontFamily="@font/ubuntu_r"
                android:padding="16dp"
                android:textStyle="bold"
                android:textSize="15sp"
                android:text="Rp.50.000"
                android:drawableTint="@color/blueColorLight"
                android:textColor="@color/blueColorLight" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="5dp"
            app:cardElevation="10dp"
            android:background="@drawable/shape_line_gray"
            >

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"

                android:orientation="vertical">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="5dp"
                android:src="@drawable/baseline_savings_24"
                android:padding="10dp"
                app:tint="@color/colorPrimaryGreen"

                />

            <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/colorGrey30" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp">


                    <TextView
                        android:textStyle="bold"
                        android:id="@+id/txt_progress_value_savings"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="7dp"
                        android:layout_marginBottom="5dp"
                        android:layout_toStartOf="@id/txt_percentage_savings"
                        android:fontFamily="@font/ubuntu_r"
                        android:text="Rp.15.000"
                        android:textColor="@color/colorPrimaryGreen"
                        android:textSize="15sp" />


                    <ProgressBar
                        android:id="@+id/progress_bar_target_savings"
                        style="@android:style/Widget.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/txt_progress_value_savings"
                        android:layout_marginBottom="10dp"
                        android:layout_toStartOf="@id/txt_percentage_savings"
                        android:progressDrawable="@drawable/progress_income_drawable"
                        tools:ignore="UnusedAttribute" />

                    <TextView
                        android:id="@+id/txt_percentage_savings"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:fontFamily="@font/lato_bold"
                        android:padding="10dp"
                        android:text="17%"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimaryGreen"
                        android:textSize="15sp" />

                </RelativeLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>
    </LinearLayout>
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="10dp"
        app:cardElevation="10dp"
        >
    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/rv_progress_savings"
        />
    </androidx.cardview.widget.CardView>
</LinearLayout>

</layout>